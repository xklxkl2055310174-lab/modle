# 默认运行真实 ResNet18；离线冒烟请设 MODEL_NAME=dummy
MODEL_NAME=resnet18
WEIGHTS_PATH=weights/resnet18-f37072fd.pth
SERVE_MODE=async_batch
DEVICE=auto
TORCH_THREADS=auto
THREADPOOL_SIZE=4
PROCESS_WORKERS=2
MAX_BATCH_SIZE=16
MAX_WAIT_MS=5.0
QUEUE_MAXSIZE=128
REQUEST_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_S=15.0
STARTUP_TIMEOUT_S=180.0
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
RATE_LIMIT_QPS=100.0
RATE_LIMIT_BURST=200
KEY_RATE_LIMIT_QPS=20.0
KEY_RATE_LIMIT_BURST=40
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_KEY_TTL_S=300.0
LOG_LEVEL=INFO
LOG_QUEUE_SIZE=10000
WARMUP_BATCHES=1,2,4,8,16,32,64
WARMUP_RUNS=2
RESOURCE_INTERVAL_S=1.0
EXP_SYNC_LOG=false
EXP_LOG_PATH=reports/sync-access.log
EXP_GLOBAL_LOCK=false
EXP_INLINE_PREPROCESS=false
EXP_UNBOUNDED_QUEUE=false
DUMMY_DELAY_MS=0.0
HOST=0.0.0.0
PORT=8000
