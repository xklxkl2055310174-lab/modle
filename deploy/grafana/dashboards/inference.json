{
  "uid": "inference",
  "title": "Small Model Inference",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "QPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_requests_total{route=\"/v1/models/{model}/predict\"}[1m]))",
          "legendFormat": "Requests"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(inference_request_seconds_bucket{route=\"/v1/models/{model}/predict\"}[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_request_seconds_bucket{route=\"/v1/models/{model}/predict\"}[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inference_request_seconds_bucket{route=\"/v1/models/{model}/predict\"}[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failure rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_requests_total{route=\"/v1/models/{model}/predict\",status!=\"200\"}[1m])) / clamp_min(sum(rate(inference_requests_total{route=\"/v1/models/{model}/predict\"}[1m])), 0.000001)",
          "legendFormat": "Failures"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue / in-flight",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_queue_depth",
          "legendFormat": "Queued"
        },
        {
          "refId": "B",
          "expr": "inference_inflight",
          "legendFormat": "In flight"
        }
      ]
    },
    {
      "id": 5,
      "title": "Batch distribution (cumulative)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(inference_batch_size_bucket[1m]))",
          "legendFormat": "Batch <= {{le}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU usage (100% = one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_cpu_percent",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 7,
      "title": "Process tree RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 8,
      "title": "GPU memory (requires valid sample)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_gpu_memory_bytes and on() (inference_gpu_sample_available == 1)",
          "legendFormat": "GPU"
        }
      ]
    },
    {
      "id": 9,
      "title": "Rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(inference_rejections_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}